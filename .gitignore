# Dependências
node_modules/

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Banco de dados local
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Dumps do SQL Server (base do Depop) — não versionados: a base viaja pelo
# export/import do admin. Só o conversor (databse/*.js) fica no git.
databse/*.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/settings.json
.idea/
*.suo
*.user

# Build / dist
dist/
build/
coverage/
.nyc_output/

# Marcador de ambiente homolog (nunca em producao)
.homolog
migracoes-homolog.json

# Scripts/arquivos descartáveis de QA (sessões Claude) — nunca fazem parte do
# projeto, só existem pra testar via curl/node -e sem tocar dado real.
_qa_*
_commit_msg_tmp.txt
_cookies.txt
